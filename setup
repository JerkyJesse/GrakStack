#!/usr/bin/env bash
# cavestack setup - install the Grak agent, the grak-clone and grak-builder
# subagents, and the /grak, /review, /team, /ship, /land commands into supported
# AI coding hosts. No network, no bun, no node, no sudo.
#
# The cage rule: never delete or edit a target without proof that we own it.
# A target is ours when it is a symlink resolving into this repo, or a file
# carrying the cavestack-owned marker (the legacy cavestack-managed marker also
# counts). Everything else is skipped and reported, never touched.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd -P)"

OWN_GREP="cavestack-(owned|managed)"
AGENT_SRC="$ROOT/characters/grak/grak-agent.md"
CMD_SRC="$ROOT/characters/grak/commands"
CLONE_MISSION_SRC="$ROOT/characters/grak/clone-mission.md"
BUILDER_MISSION_SRC="$ROOT/characters/grak/builder-mission.md"
DIGEST_SRC="$ROOT/characters/grak/digest.md"
COMMANDS="grak review team ship land"
SUPPORT_DIR="$HOME/.cavestack"
SUPPORT_FILES="GRAK.md GRAK_CREDENTIALS.md exam.py mcq_bank.json"
SUPPORT_MARKER=".cavestack-owned"

ALL_HOSTS="claude cursor codex factory opencode kiro slate openclaw hermes gbrain"
AUTO_HOSTS="claude cursor codex factory opencode kiro openclaw hermes gbrain"

HOST="claude"
UNINSTALL=0
CHECK=0
QUIET=0
AGENT_COUNT=0
CLONE_COUNT=0
BUILDER_COUNT=0
COMMAND_COUNT=0
DIGEST_COUNT=0
SUPPORT_COUNT=0
REMOVED_COUNT=0
SKIP_COUNT=0

usage() {
  cat <<'EOF'
cavestack setup - Grak agent + grak-clone/grak-builder subagents + /grak, /review, /team, /ship, /land commands

Usage: ./setup [options]

Options:
  --host <name>     Install for a specific host: claude, cursor, codex, factory,
                    opencode, kiro, slate, openclaw, hermes, gbrain, all, auto.
                    Default: claude.
  --uninstall       Remove only provably-owned cavestack items for the selected
                    host(s). Everything else is left untouched.
  --check           Verify the repo's own sources (sources, markers, doctrine, rock memory).
  -q, --quiet       Suppress progress output; print only the final summary.
  -h, --help        Show this help and exit.

Examples:
  ./setup                     # install for Claude Code
  ./setup --host opencode     # Grak agent mode + the five commands
  ./setup --host all          # every supported host
  ./setup --host auto         # hosts whose config dir already exists
  ./setup --host opencode --uninstall
EOF
}

log() { [ "$QUIET" -eq 0 ] && printf '%s\n' "$@" || true; }
die() { printf 'Error: %s\n' "$1" >&2; exit 1; }

# ---------------------------------------------------------------- source helpers

# body_of <file> - print the file after its leading YAML frontmatter block.
body_of() {
  awk 'BEGIN{n=0} /^---[[:space:]]*$/{n++; if(n==2){p=1; next}} p' "$1"
}

# fm_value <file> <key> - print a frontmatter value with quotes stripped.
fm_value() {
  awk -v k="$2" 'BEGIN{n=0}
    /^---[[:space:]]*$/{n++; next}
    n==1 && index($0, k ":")==1 {
      sub("^" k ":[[:space:]]*", ""); gsub(/^"|"$/, ""); print; exit
    }' "$1"
}

is_owned() {
  if [ -L "$1" ]; then
    local resolved
    resolved="$(resolve_symlink "$1")" || return 1
    case "$resolved" in
      "$ROOT"/*) return 0 ;;
      *) return 1 ;;
    esac
  fi
  [ -f "$1" ] && grep -Eq "$OWN_GREP" "$1" 2>/dev/null
}

# resolve_symlink <path> - follow a symlink chain and print the physical target.
# Readlink only; no readlink -f / realpath, which are not portable to stock macOS.
resolve_symlink() {
  local p="$1" raw n=0
  while [ -L "$p" ]; do
    [ "$n" -lt 40 ] || return 1
    raw="$(readlink "$p" 2>/dev/null)" || return 1
    [ -n "$raw" ] || return 1
    case "$raw" in
      /*) p="$raw" ;;
      *) p="$(dirname "$p")/$raw" ;;
    esac
    n=$((n + 1))
  done
  local dir base
  dir="$(dirname "$p")"
  base="$(basename "$p")"
  dir="$(cd "$dir" 2>/dev/null && pwd -P)" || return 1
  printf '%s/%s\n' "$dir" "$base"
}

# replace_link <path> - drop an existing symlink before a write, so the write
# lands on a fresh file instead of following the link into its target.
replace_link() {
  [ -L "$1" ] && rm -f "$1"
  return 0
}

# ---------------------------------------------------------------- provenance

VERSION="$(tr -d '[:space:]' < "$ROOT/VERSION")"
[ -n "$VERSION" ] || die "cannot read VERSION from $ROOT/VERSION"
MANIFEST="$ROOT/characters/grak/ROCK_MEMORY.sha256"
[ -f "$MANIFEST" ] || die "missing rock memory manifest: $MANIFEST"
if command -v sha256sum >/dev/null 2>&1; then
  MANIFEST_HASH="$(sha256sum "$MANIFEST" | awk '{print $1}')"
elif command -v shasum >/dev/null 2>&1; then
  MANIFEST_HASH="$(shasum -a 256 "$MANIFEST" | awk '{print $1}')"
else
  die "need sha256sum or shasum to compute the rock-memory hash"
fi
HASH12="$(printf '%s' "$MANIFEST_HASH" | cut -c1-12)"

# cavestack_stamp <file> - the provenance line appended to an installed copy.
cavestack_stamp() {
  case "$1" in
    *.toml) printf '\n# cavestack v%s :: %s\n' "$VERSION" "$HASH12" ;;
    *)      printf '\n<!-- cavestack v%s :: %s -->\n' "$VERSION" "$HASH12" ;;
  esac
}

# ---------------------------------------------------------------- host mapping

_host_config_dir() {
  case "$1" in
    claude)   printf '%s\n' "$HOME/.claude" ;;
    cursor)   printf '%s\n' "$HOME/.cursor" ;;
    codex)    printf '%s\n' "${CODEX_HOME:-$HOME/.codex}" ;;
    factory)  printf '%s\n' "$HOME/.factory" ;;
    opencode) printf '%s\n' "$HOME/.config/opencode" ;;
    kiro)     printf '%s\n' "$HOME/.kiro" ;;
    openclaw) printf '%s\n' "$HOME/.openclaw" ;;
    hermes)   printf '%s\n' "$HOME/.hermes" ;;
    gbrain)   printf '%s\n' "$HOME/.gbrain" ;;
    *) printf '%s\n' "" ;;
  esac
}

_host_agents_dir() {
  case "$1" in
    claude)   printf '%s\n' "$HOME/.claude/agents" ;;
    cursor)   printf '%s\n' "$HOME/.cursor/agents" ;;
    codex)    printf '%s\n' "${CODEX_HOME:-$HOME/.codex}/agents" ;;
    factory)  printf '%s\n' "$HOME/.factory/droids" ;;
    opencode) printf '%s\n' "$HOME/.config/opencode/agent" ;;
    kiro)     printf '%s\n' "$HOME/.kiro/agents" ;;
    *) printf '%s\n' "" ;;
  esac
}

_host_commands_dir() {
  case "$1" in
    claude)   printf '%s\n' "$HOME/.claude/commands" ;;
    cursor)   printf '%s\n' "$HOME/.cursor/commands" ;;
    codex)    printf '%s\n' "${CODEX_HOME:-$HOME/.codex}/prompts" ;;
    factory)  printf '%s\n' "$HOME/.factory/commands" ;;
    opencode) printf '%s\n' "$HOME/.config/opencode/command" ;;
    *) printf '%s\n' "" ;;
  esac
}

_host_digest_dir() {
  case "$1" in
    openclaw) printf '%s\n' "$HOME/.openclaw/skills/cavestack" ;;
    hermes)   printf '%s\n' "$HOME/.hermes/skills/cavestack" ;;
    gbrain)   printf '%s\n' "$HOME/.gbrain/skills/cavestack" ;;
    *) printf '%s\n' "" ;;
  esac
}

expand_hosts() {
  case "$HOST" in
    all) printf '%s\n' $ALL_HOSTS ;;
    auto)
      local h d
      for h in $AUTO_HOSTS; do
        d="$(_host_config_dir "$h")"
        if [ -d "$d" ]; then printf '%s\n' "$h"; fi
      done
      ;;
    *) printf '%s\n' "$HOST" ;;
  esac
}

# ---------------------------------------------------------------- install

install_agent() {
  local host="$1" dir target
  dir="$(_host_agents_dir "$host")"
  [ -n "$dir" ] || return 0
  mkdir -p "$dir"

  if [ "$host" = "codex" ]; then
    target="$dir/grak.toml"
    if [ -e "$target" ] && ! is_owned "$target"; then
      log "Not registered (a file you own already uses the name; left untouched): $target"
      SKIP_COUNT=$((SKIP_COUNT + 1)); return 0
    fi
    replace_link "$target"
    {
      printf 'name = "grak"\n'
      printf 'description = "%s"\n' "$(printf '%s' "$AGENT_DESC" | sed 's/"/\\"/g')"
      printf "developer_instructions = '''\n"
      body_of "$AGENT_SRC"
      printf "'''\n"
    } > "$target"
    cavestack_stamp "$target" >> "$target"
    AGENT_COUNT=$((AGENT_COUNT + 1))
    log "Installed agent: $target"
    return 0
  fi

  target="$dir/grak.md"
  if [ -e "$target" ] && ! is_owned "$target"; then
    log "Not registered (a file you own already uses the name; left untouched): $target"
    SKIP_COUNT=$((SKIP_COUNT + 1)); return 0
  fi
  replace_link "$target"
  case "$host" in
    opencode)
      cp -f "$AGENT_SRC" "$target"
      ;;
    claude|factory)
      { printf -- '---\nname: grak\ndescription: %s\nmodel: inherit\n---\n' "$AGENT_DESC"; body_of "$AGENT_SRC"; } > "$target"
      ;;
    cursor|kiro)
      { printf -- '---\nname: grak\ndescription: %s\n---\n' "$AGENT_DESC"; body_of "$AGENT_SRC"; } > "$target"
      ;;
  esac
  cavestack_stamp "$target" >> "$target"
  AGENT_COUNT=$((AGENT_COUNT + 1))
  log "Installed agent: $target"
}

# install_companion <host> <name> <mission-src> <ro|rw>
# Composes the shared Grak body with one mission fragment: ro = read-only
# reviewer clone, rw = write-enabled builder clone. Returns 1 when skipped.
install_companion() {
  local host="$1" name="$2" mission_src="$3" mode="$4" dir target desc sandbox
  dir="$(_host_agents_dir "$host")"
  [ -n "$dir" ] || return 1
  mkdir -p "$dir"
  desc="$(fm_value "$mission_src" description)"

  if [ "$host" = "codex" ]; then
    target="$dir/$name.toml"
    if [ -e "$target" ] && ! is_owned "$target"; then
      log "Not registered (a file you own already uses the name; left untouched): $target"
      SKIP_COUNT=$((SKIP_COUNT + 1)); return 1
    fi
    replace_link "$target"
    if [ "$mode" = "rw" ]; then sandbox="workspace-write"; else sandbox="read-only"; fi
    {
      printf 'name = "%s"\n' "$name"
      printf 'description = "%s"\n' "$(printf '%s' "$desc" | sed 's/"/\\"/g')"
      printf 'sandbox_mode = "%s"\n' "$sandbox"
      printf "developer_instructions = '''\n"
      body_of "$AGENT_SRC"
      printf '\n'
      body_of "$mission_src"
      printf "'''\n"
    } > "$target"
    cavestack_stamp "$target" >> "$target"
    log "Installed companion: $target"
    return 0
  fi

  target="$dir/$name.md"
  if [ -e "$target" ] && ! is_owned "$target"; then
    log "Not registered (a file you own already uses the name; left untouched): $target"
    SKIP_COUNT=$((SKIP_COUNT + 1)); return 1
  fi
  replace_link "$target"
  case "$host" in
    opencode)
      if [ "$mode" = "ro" ]; then
        { printf -- '---\ndescription: %s\nmode: subagent\npermission:\n  edit: deny\n---\n' "$desc"; body_of "$AGENT_SRC"; printf '\n'; body_of "$mission_src"; } > "$target"
      else
        { printf -- '---\ndescription: %s\nmode: subagent\n---\n' "$desc"; body_of "$AGENT_SRC"; printf '\n'; body_of "$mission_src"; } > "$target"
      fi
      ;;
    claude)
      if [ "$mode" = "ro" ]; then
        { printf -- '---\nname: %s\ndescription: %s\nmodel: inherit\ntools: Read, Grep, Glob, Bash\n---\n' "$name" "$desc"; body_of "$AGENT_SRC"; printf '\n'; body_of "$mission_src"; } > "$target"
      else
        { printf -- '---\nname: %s\ndescription: %s\nmodel: inherit\n---\n' "$name" "$desc"; body_of "$AGENT_SRC"; printf '\n'; body_of "$mission_src"; } > "$target"
      fi
      ;;
    factory)
      if [ "$mode" = "ro" ]; then
        { printf -- '---\nname: %s\ndescription: %s\nmodel: inherit\ntools: read-only\n---\n' "$name" "$desc"; body_of "$AGENT_SRC"; printf '\n'; body_of "$mission_src"; } > "$target"
      else
        { printf -- '---\nname: %s\ndescription: %s\nmodel: inherit\n---\n' "$name" "$desc"; body_of "$AGENT_SRC"; printf '\n'; body_of "$mission_src"; } > "$target"
      fi
      ;;
    cursor)
      if [ "$mode" = "ro" ]; then
        { printf -- '---\nname: %s\ndescription: %s\nmodel: inherit\nreadonly: true\n---\n' "$name" "$desc"; body_of "$AGENT_SRC"; printf '\n'; body_of "$mission_src"; } > "$target"
      else
        { printf -- '---\nname: %s\ndescription: %s\nmodel: inherit\n---\n' "$name" "$desc"; body_of "$AGENT_SRC"; printf '\n'; body_of "$mission_src"; } > "$target"
      fi
      ;;
    kiro)
      { printf -- '---\nname: %s\ndescription: %s\n---\n' "$name" "$desc"; body_of "$AGENT_SRC"; printf '\n'; body_of "$mission_src"; } > "$target"
      ;;
  esac
  cavestack_stamp "$target" >> "$target"
  log "Installed companion: $target"
  return 0
}

install_clone() {
  if install_companion "$1" grak-clone "$CLONE_MISSION_SRC" ro; then
    CLONE_COUNT=$((CLONE_COUNT + 1))
  fi
}

install_builder() {
  if install_companion "$1" grak-builder "$BUILDER_MISSION_SRC" rw; then
    BUILDER_COUNT=$((BUILDER_COUNT + 1))
  fi
}

install_commands() {
  local host="$1" dir name src target desc
  dir="$(_host_commands_dir "$host")"
  [ -n "$dir" ] || return 0
  mkdir -p "$dir"
  for name in $COMMANDS; do
    src="$CMD_SRC/$name.md"
    target="$dir/$name.md"
    if [ -e "$target" ] && ! is_owned "$target"; then
      log "Not registered (a file you own already uses the name; left untouched): $target"
      SKIP_COUNT=$((SKIP_COUNT + 1)); continue
    fi
    replace_link "$target"
    desc="$(fm_value "$src" description)"
    if [ "$host" = "opencode" ]; then
      { printf -- '---\ndescription: %s\nagent: grak\n---\n' "$desc"; body_of "$src"; } > "$target"
    else
      { printf -- '---\ndescription: %s\n---\n' "$desc"; body_of "$src"; } > "$target"
    fi
    cavestack_stamp "$target" >> "$target"
    COMMAND_COUNT=$((COMMAND_COUNT + 1))
    log "Installed command: $target"
  done
}

install_digest() {
  local host="$1" dir target
  dir="$(_host_digest_dir "$host")"
  [ -n "$dir" ] || return 0
  mkdir -p "$dir"
  target="$dir/SKILL.md"
  if [ -e "$target" ] && ! is_owned "$target"; then
    log "Not registered (a file you own already uses the name; left untouched): $target"
    SKIP_COUNT=$((SKIP_COUNT + 1)); return 0
  fi
  replace_link "$target"
  cp -f "$DIGEST_SRC" "$target"
  cavestack_stamp "$target" >> "$target"
  DIGEST_COUNT=$((DIGEST_COUNT + 1))
  log "Installed digest: $target"
}

install_host() {
  install_agent "$1"
  install_clone "$1"
  install_builder "$1"
  install_commands "$1"
}

# ---------------------------------------------------------------- support (lore + credentials)

_support_src() {
  case "$1" in
    GRAK.md) printf '%s\n' "$ROOT/characters/grak/GRAK.md" ;;
    *)       printf '%s\n' "$ROOT/characters/grak/credentials/$1" ;;
  esac
}

install_support() {
  local marker="$SUPPORT_DIR/$SUPPORT_MARKER" name src
  if [ -d "$SUPPORT_DIR" ] && [ ! -e "$marker" ] && [ -n "$(ls -A "$SUPPORT_DIR" 2>/dev/null)" ]; then
    log "Not registered (a directory you own already uses the path; left untouched): $SUPPORT_DIR"
    SKIP_COUNT=$((SKIP_COUNT + 1)); return 0
  fi
  mkdir -p "$SUPPORT_DIR"
  for name in $SUPPORT_FILES; do
    src="$(_support_src "$name")"
    cp "$src" "$SUPPORT_DIR/$name"
  done
  printf '<!-- cavestack-owned -->\n' > "$marker"
  printf 'cavestack %s\nsha256 %s\n' "$VERSION" "$MANIFEST_HASH" > "$SUPPORT_DIR/ROCK_RECEIPT"
  SUPPORT_COUNT=$((SUPPORT_COUNT + 1))
  log "Installed record: $SUPPORT_DIR (GRAK.md, GRAK_CREDENTIALS.md, exam.py, mcq_bank.json, ROCK_RECEIPT)"
}

uninstall_support() {
  local marker="$SUPPORT_DIR/$SUPPORT_MARKER" name
  if [ ! -e "$marker" ]; then
    if [ -d "$SUPPORT_DIR" ]; then
      log "Kept (not ours): $SUPPORT_DIR"
      SKIP_COUNT=$((SKIP_COUNT + 1))
    fi
    return 0
  fi
  for name in $SUPPORT_FILES; do
    if [ -e "$SUPPORT_DIR/$name" ]; then
      rm -f "$SUPPORT_DIR/$name"
      REMOVED_COUNT=$((REMOVED_COUNT + 1))
    fi
  done
  rm -f "$marker"
  rm -f "$SUPPORT_DIR/ROCK_RECEIPT"
  rmdir "$SUPPORT_DIR" 2>/dev/null || true
  log "Removed record: $SUPPORT_DIR"
}

# ---------------------------------------------------------------- uninstall

uninstall_file() {
  local target="$1"
  [ -e "$target" ] || [ -L "$target" ] || return 0
  if is_owned "$target"; then
    rm -f "$target"
    REMOVED_COUNT=$((REMOVED_COUNT + 1))
    log "Removed: $target"
  else
    log "Kept (not ours): $target"
    SKIP_COUNT=$((SKIP_COUNT + 1))
  fi
}

uninstall_host() {
  local host="$1" adir cdir ddir name
  adir="$(_host_agents_dir "$host")"
  if [ -n "$adir" ]; then
    if [ "$host" = "codex" ]; then
      uninstall_file "$adir/grak.toml"
      uninstall_file "$adir/grak-clone.toml"
      uninstall_file "$adir/grak-builder.toml"
    else
      uninstall_file "$adir/grak.md"
      uninstall_file "$adir/grak-clone.md"
      uninstall_file "$adir/grak-builder.md"
    fi
  fi
  cdir="$(_host_commands_dir "$host")"
  if [ -n "$cdir" ]; then
    for name in $COMMANDS; do
      uninstall_file "$cdir/$name.md"
    done
  fi
  ddir="$(_host_digest_dir "$host")"
  if [ -n "$ddir" ]; then
    uninstall_file "$ddir/SKILL.md"
    rmdir "$ddir" 2>/dev/null || true
  fi
}

# ---------------------------------------------------------------- check

check() {
  local fail=0 name f
  for f in "$AGENT_SRC" "$DIGEST_SRC" "$CMD_SRC/grak.md" "$CMD_SRC/review.md" "$CMD_SRC/team.md" "$CMD_SRC/ship.md" "$CMD_SRC/land.md" "$CLONE_MISSION_SRC" "$BUILDER_MISSION_SRC" "$ROOT/characters/grak/GRAK.md" "$ROOT/characters/grak/credentials/GRAK_CREDENTIALS.md" "$ROOT/characters/grak/credentials/exam.py" "$ROOT/characters/grak/credentials/mcq_bank.json" "$ROOT/characters/grak/rock_memory.py" "$MANIFEST" "$ROOT/docs/install"; do
    [ -f "$f" ] || { printf 'missing source: %s\n' "$f" >&2; fail=1; }
  done
  [ "$fail" -eq 0 ] || exit 1
  grep -q 'cavestack-owned' "$AGENT_SRC" || { echo 'agent source missing ownership marker' >&2; fail=1; }
  grep -q 'cavestack-owned' "$DIGEST_SRC" || { echo 'digest source missing ownership marker' >&2; fail=1; }
  grep -q 'cavestack-owned' "$CLONE_MISSION_SRC" || { echo 'clone mission source missing ownership marker' >&2; fail=1; }
  [ -n "$(fm_value "$CLONE_MISSION_SRC" description)" ] || { echo 'clone mission source missing description' >&2; fail=1; }
  grep -q 'one clone of Grak' "$CLONE_MISSION_SRC" || { echo 'clone mission source missing clone duty' >&2; fail=1; }
  grep -q 'cavestack-owned' "$BUILDER_MISSION_SRC" || { echo 'builder mission source missing ownership marker' >&2; fail=1; }
  [ -n "$(fm_value "$BUILDER_MISSION_SRC" description)" ] || { echo 'builder mission source missing description' >&2; fail=1; }
  grep -q 'one builder clone of Grak' "$BUILDER_MISSION_SRC" || { echo 'builder mission source missing builder duty' >&2; fail=1; }
  grep -q 'exec bash' "$ROOT/docs/install" || { echo 'docs/install must exec bash (setup is a bash script, sh may be dash)' >&2; fail=1; }
  grep -q 'Ship fully finished code, fast' "$AGENT_SRC" || { echo 'agent source missing finish doctrine' >&2; fail=1; }
  for name in $COMMANDS; do
    f="$CMD_SRC/$name.md"
    [ -n "$(fm_value "$f" description)" ] || { echo "command $name missing description" >&2; fail=1; }
    grep -q 'cavestack-owned' "$f" || { echo "command $name missing ownership marker" >&2; fail=1; }
    grep -q 'ARGUMENTS' "$f" || { echo "command $name missing \$ARGUMENTS" >&2; fail=1; }
  done
  if [ "$fail" -eq 0 ] && command -v python3 >/dev/null 2>&1; then
    python3 "$ROOT/characters/grak/rock_memory.py" --check --no-receipt || fail=1
  fi
  if [ "$fail" -eq 0 ]; then
    echo "cavestack: check ok"
  else
    exit 1
  fi
}

# ---------------------------------------------------------------- main

while [ $# -gt 0 ]; do
  case "$1" in
    --host) [ -n "${2:-}" ] || die "missing value for --host"; HOST="$2"; shift 2 ;;
    --host=*) HOST="${1#--host=}"; shift ;;
    --uninstall) UNINSTALL=1; shift ;;
    --check) CHECK=1; shift ;;
    -q|--quiet) QUIET=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown option: $1 (run ./setup --help)" ;;
  esac
done

case "$HOST" in
  claude|cursor|codex|factory|opencode|kiro|slate|openclaw|hermes|gbrain|all|auto) ;;
  *) die "unknown --host value: $HOST (expected claude, cursor, codex, factory, opencode, kiro, slate, openclaw, hermes, gbrain, all, auto)" ;;
esac

if [ "$CHECK" -eq 1 ]; then
  check
  exit 0
fi

AGENT_DESC="$(fm_value "$AGENT_SRC" description)"
[ -n "$AGENT_DESC" ] || die "cannot read description from $AGENT_SRC"
[ -n "$(fm_value "$CLONE_MISSION_SRC" description)" ] || die "cannot read description from $CLONE_MISSION_SRC"
[ -n "$(fm_value "$BUILDER_MISSION_SRC" description)" ] || die "cannot read description from $BUILDER_MISSION_SRC"

HOSTS="$(expand_hosts)"
[ -n "$HOSTS" ] || die "no hosts selected (nothing to do)"

if [ "$UNINSTALL" -eq 1 ]; then
  uninstall_support
else
  install_support
fi

while IFS= read -r h; do
  [ -n "$h" ] || continue
  case "$h" in
    slate)
      log "Slate reads Claude Code config; $( [ "$UNINSTALL" -eq 1 ] && echo 'uninstalling' || echo 'installing' ) claude instead."
      if [ "$UNINSTALL" -eq 1 ]; then uninstall_host claude; else install_host claude; fi
      ;;
    openclaw|hermes|gbrain)
      if [ "$UNINSTALL" -eq 1 ]; then uninstall_host "$h"; else install_digest "$h"; fi
      ;;
    *)
      if [ "$UNINSTALL" -eq 1 ]; then uninstall_host "$h"; else install_host "$h"; fi
      ;;
  esac
done <<EOF
$HOSTS
EOF

if [ "$UNINSTALL" -eq 1 ]; then
  echo "cavestack uninstall complete."
  echo "  removed:          $REMOVED_COUNT"
  echo "  skipped (not ours): $SKIP_COUNT"
else
  echo "cavestack ready ($HOST)."
  echo "  agents installed:   $AGENT_COUNT"
  echo "  clones installed:   $CLONE_COUNT"
  echo "  builders installed: $BUILDER_COUNT"
  echo "  commands installed: $COMMAND_COUNT"
  echo "  digests installed:  $DIGEST_COUNT"
  if [ "$SUPPORT_COUNT" -gt 0 ]; then echo "  record installed:   $SUPPORT_DIR"; fi
  if [ "$SKIP_COUNT" -gt 0 ]; then echo "  skipped (not ours): $SKIP_COUNT"; fi
  echo "Open a new session. Tab to grak. Run /grak."
fi
