# Default: normalize all text files to LF on commit, check out LF everywhere.
# Overrides Windows core.autocrlf=true so tracked files stop showing as dirty.
* text=auto eol=lf

# Windows-native scripts must stay CRLF
*.ps1 text eol=crlf

# Explicit binary types (prevent accidental normalization)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
